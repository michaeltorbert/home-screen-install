{
  "name": "home-screen-install",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent Add to Home Screen guide button that shows only while the page is not running as a Home Screen web app.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/home-screen-install.mjs",
      "default": "./dist/home-screen-install.mjs"
    },
    "./classic": "./dist/home-screen-install.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "ADOPTING.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/home-screen-install.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/build.mjs --check",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser/run.mjs",
    "demo": "node demo/serve.mjs",
    "stage:consumer": "node scripts/stage-consumer.mjs",
    "release": "node scripts/release.mjs",
    "update:consumers": "node scripts/update-consumers.mjs",
    "install:runner": "node scripts/install-runner.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
